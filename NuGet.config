<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-scoped package source.

  This machine's NuGet.Config at %APPDATA%\NuGet\NuGet.Config has an
  intentionally empty <packageSources> block, so without this file a restore
  fails with "No NuGet sources are defined or enabled"; or, worse, appears to
  succeed purely because the package is already in the global cache from
  another repo. NuGet walks up from the project directory, so placing this at
  the repo root covers every mod here.

  Only needed by the MSBuild path (SelfSealingAirlocksFixed.csproj, which pulls
  Microsoft.NETFramework.ReferenceAssemblies). The mcs-based build.sh scripts
  do not use NuGet at all.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
